# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Postgres (docker-compose provides this value by default)
DATABASE_URL=postgresql+psycopg://riverbend:riverbend@localhost:5432/riverbend

# Per-shop monthly LLM spend cap, in USD (applied to every shop for the prototype)
MONTHLY_SPEND_CAP_USD=5.00

# Simulate provider failure modes in local demos: none | slow | down
LLM_FAULT_MODE=none
